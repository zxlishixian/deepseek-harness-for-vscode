{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 DeepSeek Harness 扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      "preLaunchTask": "npm: compile"
    }
  ]
}
